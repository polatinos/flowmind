{
  "id": "nl.polatinos.flowmind",
  "version": "0.6.4",
  "compatibility": ">=8.1.4",
  "sdk": 3,
  "platforms": ["local"],
  "name": {
    "en": "FlowMind",
    "nl": "FlowMind"
  },
  "description": {
    "en": "An AI assistant that runs on your Homey Pro. Chat in plain language and it reads your system, controls devices and builds (advanced) flows for you.",
    "nl": "Een AI-assistent die op je Homey Pro draait. Chat in gewone taal en het leest je systeem uit, stuurt apparaten aan en bouwt (advanced) flows voor je."
  },
  "category": ["tools"],
  "brandColor": "#5B5BF7",
  "tags": {
    "en": ["ai", "assistant", "chatgpt", "claude", "llm", "flow", "advanced flow"],
    "nl": ["ai", "assistent", "chatgpt", "claude", "llm", "flow", "advanced flow"]
  },
  "permissions": [
    "homey:manager:api"
  ],
  "api": {
    "getConfig": { "method": "GET", "path": "/config" },
    "saveConfig": { "method": "PUT", "path": "/config" },
    "chat": { "method": "POST", "path": "/chat" },
    "getChatJob": { "method": "GET", "path": "/chat/:jobId" },
    "getMemories": { "method": "GET", "path": "/memories" },
    "deleteMemory": { "method": "DELETE", "path": "/memories/:id" }
  },
  "flow": {
    "actions": [
      {
        "id": "ai_do",
        "title": {
          "en": "Have FlowMind do…",
          "nl": "Laat FlowMind iets doen…"
        },
        "titleFormatted": {
          "en": "Have FlowMind [[instruction]]",
          "nl": "Laat FlowMind [[instruction]]"
        },
        "hint": {
          "en": "The AI performs this instruction on your Homey (control devices, check things, etc.).",
          "nl": "De AI voert deze opdracht uit op je Homey (apparaten aansturen, dingen controleren, enz.)."
        },
        "args": [
          {
            "name": "instruction",
            "type": "text",
            "title": {
              "en": "Instruction",
              "nl": "Opdracht"
            },
            "placeholder": {
              "en": "turn off all lights downstairs",
              "nl": "zet alle lampen beneden uit"
            }
          }
        ]
      },
      {
        "id": "ai_ask",
        "title": {
          "en": "Ask FlowMind…",
          "nl": "Vraag FlowMind…"
        },
        "titleFormatted": {
          "en": "Ask FlowMind [[question]]",
          "nl": "Vraag FlowMind [[question]]"
        },
        "hint": {
          "en": "The AI answers your question and returns the answer as a tag for the next cards (Advanced Flow).",
          "nl": "De AI beantwoordt je vraag en geeft het antwoord terug als tag voor de volgende kaarten (Advanced Flow)."
        },
        "args": [
          {
            "name": "question",
            "type": "text",
            "title": {
              "en": "Question",
              "nl": "Vraag"
            },
            "placeholder": {
              "en": "which windows are still open?",
              "nl": "welke ramen staan nog open?"
            }
          }
        ],
        "tokens": [
          {
            "name": "response",
            "type": "string",
            "title": {
              "en": "Response",
              "nl": "Antwoord"
            }
          }
        ]
      }
    ]
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Tarik Polat",
    "email": "tarik-polat@live.nl"
  },
  "source": "https://github.com/polatinos/flowmind",
  "support": "mailto:tarik-polat@live.nl",
  "bugs": {
    "url": "https://github.com/polatinos/flowmind/issues"
  }
}
